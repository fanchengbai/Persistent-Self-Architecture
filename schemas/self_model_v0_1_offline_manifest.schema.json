{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://persistent-self-architecture.local/schemas/self_model_v0_1_offline_manifest.schema.json",
  "title": "PSA Self Model v0.1 offline evidence manifest",
  "type": "object",
  "required": [
    "manifest_version",
    "status",
    "valid",
    "development_only",
    "model_loaded",
    "model_executed",
    "real_rwkv_coupling_implemented",
    "source_digests",
    "manifest_digest_sha256"
  ],
  "properties": {
    "manifest_version": {"const": "0.1-offline"},
    "status": {"const": "self_model_v0_1_offline_interfaces_verified"},
    "valid": {"const": true},
    "development_only": {"const": true},
    "model_loaded": {"const": false},
    "model_executed": {"const": false},
    "real_rwkv_coupling_implemented": {"const": false},
    "source_digests": {"type": "object"},
    "manifest_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
