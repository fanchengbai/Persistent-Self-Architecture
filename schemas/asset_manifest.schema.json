{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://persistent-self-architecture.local/schemas/asset_manifest.schema.json",
  "title": "PSA Asset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "bundle_id",
    "description",
    "assets",
    "generated_assets"
  ],
  "properties": {
    "manifest_version": {
      "type": "string",
      "const": "0.1"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/downloadAsset"
      }
    },
    "generated_assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/generatedAsset"
      }
    }
  },
  "$defs": {
    "downloadAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "destination",
        "license",
        "source_page",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]+$"
        },
        "kind": {
          "enum": [
            "model",
            "tokenizer",
            "dataset",
            "code"
          ]
        },
        "destination": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "source_page": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "repo_type",
            "repo_id",
            "revision",
            "filename"
          ],
          "properties": {
            "type": {
              "const": "huggingface"
            },
            "repo_type": {
              "enum": [
                "model",
                "dataset"
              ]
            },
            "repo_id": {
              "type": "string",
              "pattern": "^[^/]+/[^/]+$"
            },
            "revision": {
              "type": "string",
              "minLength": 7
            },
            "filename": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "generatedAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "destination",
        "generator",
        "config",
        "confirmatory"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "const": "dataset"
        },
        "destination": {
          "type": "string"
        },
        "generator": {
          "type": "string"
        },
        "config": {
          "type": "string"
        },
        "confirmatory": {
          "type": "boolean",
          "const": false
        }
      }
    }
  }
}
