{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://persistent-self-architecture.local/schemas/checkpoint_restore_report.schema.json",
  "title": "PSA Development Checkpoint Restore Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_version",
    "created_at_utc",
    "development_only",
    "mode",
    "process_is_distinct",
    "repeat_count",
    "checkpoint_verification",
    "checkpoint_stable_during_probe",
    "exact_repeat_count",
    "worst_error",
    "timing_seconds",
    "cuda_peak_memory_bytes",
    "trials",
    "achieved_level",
    "valid"
  ],
  "properties": {
    "report_version": {
      "const": "0.1"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "development_only": {
      "const": true
    },
    "mode": {
      "const": "disk_cross_process_restore"
    },
    "process_is_distinct": {
      "type": "boolean"
    },
    "repeat_count": {
      "type": "integer",
      "minimum": 100
    },
    "checkpoint_verification": {
      "type": "object"
    },
    "checkpoint_stable_during_probe": {
      "type": "boolean"
    },
    "exact_repeat_count": {
      "type": "integer",
      "minimum": 0
    },
    "worst_error": {
      "type": "object"
    },
    "timing_seconds": {
      "type": "object"
    },
    "cuda_peak_memory_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "trials": {
      "type": "array",
      "minItems": 100,
      "items": {
        "type": "object"
      }
    },
    "achieved_level": {
      "enum": ["L2", "L3"]
    },
    "valid": {
      "type": "boolean"
    }
  }
}
