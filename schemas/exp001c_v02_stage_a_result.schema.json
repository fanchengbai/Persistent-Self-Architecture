{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://persistent-self-architecture.local/schemas/exp001c_v02_stage_a_result.schema.json",
  "title": "EXP-001C v02 Stage A Prompt-Visible Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_version",
    "experiment_id",
    "status",
    "development_only",
    "non_core",
    "model_executed",
    "prompt_visible_only",
    "stage_b_recurrent_state_accessed",
    "formal_test_set_accessed",
    "formal_run",
    "contains_confirmatory_decision",
    "manifest_digest_sha256",
    "record_count",
    "warmup_token_lengths",
    "records"
  ],
  "properties": {
    "result_version": {"const": "0.2-stage-a-development"},
    "experiment_id": {"const": "EXP-001C"},
    "status": {"const": "v02_stage_a_prompt_visible_complete"},
    "development_only": {"const": true},
    "non_core": {"const": true},
    "model_executed": {"const": true},
    "prompt_visible_only": {"const": true},
    "stage_b_recurrent_state_accessed": {"const": false},
    "formal_test_set_accessed": {"const": false},
    "formal_run": {"const": false},
    "contains_confirmatory_decision": {"const": false},
    "manifest_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record_count": {"const": 32},
    "warmup_token_lengths": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": 1}
    },
    "records": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id",
        "semantic_case_id",
        "rotation_index",
        "target_code",
        "prompt_token_count",
        "prefix_evidence",
        "option_log_probabilities",
        "answer_boundary_evidence"
      ],
      "properties": {
        "sample_id": {"type": "string", "minLength": 1},
        "semantic_case_id": {"type": "string", "minLength": 1},
        "rotation_index": {"type": "integer", "minimum": 0, "maximum": 3},
        "target_code": {"enum": ["A", "B", "C", "D"]},
        "prompt_token_count": {"type": "integer", "minimum": 1},
        "prefix_evidence": {"$ref": "exp001c_prefix_evidence.schema.json"},
        "option_log_probabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["A", "B", "C", "D"],
          "properties": {
            "A": {"type": "number"},
            "B": {"type": "number"},
            "C": {"type": "number"},
            "D": {"type": "number"}
          }
        },
        "answer_boundary_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target_code",
            "target_answer_log_probability",
            "best_incorrect_code",
            "best_incorrect_answer_log_probability",
            "target_margin_over_best_incorrect"
          ],
          "properties": {
            "target_code": {"enum": ["A", "B", "C", "D"]},
            "target_answer_log_probability": {"type": "number"},
            "best_incorrect_code": {"enum": ["A", "B", "C", "D"]},
            "best_incorrect_answer_log_probability": {"type": "number"},
            "target_margin_over_best_incorrect": {"type": "number"}
          }
        }
      }
    }
  }
}
