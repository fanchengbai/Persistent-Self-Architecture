{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Self Model v0.1 D5C-P1 single-use real engineering authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorization_version", "stage", "scope", "authorized", "authorization_basis",
    "authorization_text", "authorized_at_utc", "git_commit", "config_sha256",
    "entry_static_report_sha256", "model_execution_authorized",
    "result_observation_authorized", "engineering_validation_only",
    "historical_d5c_rerun_authorized", "historical_d5c_conclusion_change_authorized",
    "d5d_authorized", "d5e_authorized", "formal_test_set_authorized",
    "self_effect_conclusion_authorized", "real_self_projection_authorized",
    "self_updater_authorized", "automatic_rerun_authorized", "single_use",
    "authorization_digest_sha256"
  ],
  "properties": {
    "authorization_version": {"const": "0.1-d5c-p1-real-engineering-entry"},
    "stage": {"const": "D5C-P1_patched_real_2_9b_noncore_engineering_execution"},
    "scope": {"const": "one_fixed_12_call_engineering_validation_and_observation"},
    "authorized": {"const": true},
    "authorization_basis": {"const": "project_owner_explicit_future_chat_authorization"},
    "authorization_text": {"const": "授权执行 Self Model v0.1 D5C-P1 补丁后真实2.9B非Core工程验证一次（固定两个夹具、每夹具6次、共12次调用），并授权观察本次工程结果；不授权重跑原D5C、不改变历史失败结论，也不授权D5D/D5E、正式测试集、Self效果结论、真实Self projection、Self Updater或自动重跑。"},
    "authorized_at_utc": {"type": "string", "format": "date-time"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entry_static_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_execution_authorized": {"const": true},
    "result_observation_authorized": {"const": true},
    "engineering_validation_only": {"const": true},
    "historical_d5c_rerun_authorized": {"const": false},
    "historical_d5c_conclusion_change_authorized": {"const": false},
    "d5d_authorized": {"const": false},
    "d5e_authorized": {"const": false},
    "formal_test_set_authorized": {"const": false},
    "self_effect_conclusion_authorized": {"const": false},
    "real_self_projection_authorized": {"const": false},
    "self_updater_authorized": {"const": false},
    "automatic_rerun_authorized": {"const": false},
    "single_use": {"const": true},
    "authorization_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
