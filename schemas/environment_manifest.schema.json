{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://persistent-self-architecture.local/schemas/environment_manifest.schema.json",
  "title": "PSA Development Environment Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_version",
    "created_at_utc",
    "development_only",
    "project_root",
    "git",
    "platform",
    "nvidia_smi",
    "torch",
    "rwkv",
    "numpy",
    "safetensors",
    "runtime_environment",
    "disk",
    "expected",
    "checks",
    "valid"
  ],
  "properties": {
    "report_version": {
      "const": "0.1"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "development_only": {
      "const": true
    },
    "project_root": {
      "type": "string"
    },
    "git": {
      "type": "object"
    },
    "platform": {
      "type": "object"
    },
    "nvidia_smi": {
      "type": "object"
    },
    "torch": {
      "type": "object"
    },
    "rwkv": {
      "type": "object"
    },
    "numpy": {
      "type": "object"
    },
    "safetensors": {
      "type": "object"
    },
    "runtime_environment": {
      "type": "object"
    },
    "disk": {
      "type": "object"
    },
    "expected": {
      "type": "object"
    },
    "checks": {
      "type": "object",
      "required": [
        "python_supported",
        "numpy_version_pinned",
        "safetensors_version_pinned",
        "torch_version_pinned",
        "torch_cuda_pinned",
        "cuda_available",
        "rwkv_version_pinned"
      ]
    },
    "valid": {
      "type": "boolean"
    }
  }
}
