{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://persistent-self-architecture.local/schemas/state_inventory.schema.json",
  "title": "PSA Native State Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "inventory_version",
    "created_at_utc",
    "development_only",
    "model_id",
    "component_count",
    "total_size_bytes",
    "all_finite",
    "components",
    "state_digest_sha256"
  ],
  "properties": {
    "inventory_version": {
      "const": "0.1"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "development_only": {
      "const": true
    },
    "model_id": {
      "type": "string"
    },
    "component_count": {
      "type": "integer",
      "minimum": 1
    },
    "total_size_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "all_finite": {
      "type": "boolean"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "state_digest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
