{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://persistent-self-architecture.local/schemas/random_state_summary.schema.json",
  "title": "PSA Development Matched Random State Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gate",
    "started_at_utc",
    "finished_at_utc",
    "development_only",
    "model_id",
    "gate_config_sha256",
    "tokenizer_roundtrip_valid",
    "component_count",
    "source_state_immutable",
    "same_seed_bitwise_reproducible",
    "different_seed_distinct",
    "scale_match_valid",
    "max_relative_l2_error",
    "continuation_valid",
    "valid",
    "reports"
  ],
  "properties": {
    "gate": {"const": "impl2c_random_matched"},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "finished_at_utc": {"type": "string", "format": "date-time"},
    "development_only": {"const": true},
    "model_id": {"type": "string", "minLength": 1},
    "gate_config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tokenizer_roundtrip_valid": {"type": "boolean"},
    "component_count": {"type": "integer", "minimum": 1},
    "source_state_immutable": {"type": "boolean"},
    "same_seed_bitwise_reproducible": {"type": "boolean"},
    "different_seed_distinct": {"type": "boolean"},
    "scale_match_valid": {"type": "boolean"},
    "max_relative_l2_error": {"type": "number", "minimum": 0},
    "continuation_valid": {"type": "boolean"},
    "valid": {"type": "boolean"},
    "reports": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    }
  }
}
