    "mode": "single_statement",
    "templates": [
      {
        "id": "formal-history-01",
        "user_text": "SAVE THE CURRENT STATE AS ONE BINDING.\nCURRENT DOMAIN: {domain}\nCURRENT OPERATION: {operation}",
        "assistant_ack": "Current state saved."
      },
      {
        "id": "formal-history-02",
        "user_text": "RECORD ONE ACTIVE STATE BINDING.\nACTIVE DOMAIN: {domain}\nACTIVE OPERATION: {operation}",
        "assistant_ack": "Active state recorded."
      },
      {
        "id": "formal-history-03",
        "user_text": "SET THE PRESENT STATE IN A SINGLE RECORD.\nPRESENT DOMAIN: {domain}\nPRESENT OPERATION: {operation}",
        "assistant_ack": "Present state set."
      },
      {
        "id": "formal-history-04",
        "user_text": "STORE THIS ONE CURRENT CONFIGURATION.\nCONFIGURATION DOMAIN: {domain}\nCONFIGURATION OPERATION: {operation}",
        "assistant_ack": "Current configuration stored."
      }
    ]
  },
  "query_protocol": {
    "general_rule_visible": true,
    "current_values_visible_outside_balanced_options": false,
    "templates": [
      {
        "id": "formal-query-01",
        "user_text": "TASK: exact two-field state match.\nGENERAL RULE: choose the unique option matching both the saved domain and saved operation.\nThe saved values are not repeated outside the balanced options.\nOPTIONS:\n{options}\nReply with the matching option code only."
      },
      {
        "id": "formal-query-02",
        "user_text": "TASK: recover the paired state.\nGENERAL RULE: select the sole option whose domain and operation both equal the stored state.\nNo current value is stated outside the balanced options.\nOPTIONS:\n{options}\nReturn only the corresponding option code."
      },
      {
        "id": "formal-query-03",
        "user_text": "TASK: identify the complete saved binding.\nGENERAL RULE: an option is correct only when both its domain field and operation field match the current state.\nCurrent fields appear only inside the balanced options.\nOPTIONS:\n{options}\nAnswer using only one option code."
      },
      {
        "id": "formal-query-04",
        "user_text": "TASK: choose the state-consistent pair.\nGENERAL RULE: compare both fields and choose the one option consistent with the stored domain-operation binding.\nThe hidden current values are not disclosed beyond the balanced options.\nOPTIONS:\n{options}\nProvide the matching code only."
      }
    ]
  },
